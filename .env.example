# ─── Database ────────────────────────────────────────────────────────────────
# Local dev: `npm run db:start` runs a real PostgreSQL server on port 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/tikiti
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/tikiti_test

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL used in emails and payment callbacks (https:// in production).
# APP_URL is the older name and still works; APP_BASE_URL wins when both are set.
APP_BASE_URL=http://localhost:3000
# Secrets: generate each with `openssl rand -base64 48`. Never commit real values.
SESSION_SECRET=change-me
QR_SIGNING_SECRET=change-me
ACCESS_LINK_SECRET=change-me

# ─── Payments ────────────────────────────────────────────────────────────────
# Each method has its own provider:
#   MPESA_PROVIDER = mock (simulated page, no money moves) | daraja (Safaricom STK Push)
#   CARD_PROVIDER  = mock | disabled   (defaults to "disabled" when DARAJA_ENV=production)
# PAYMENT_PROVIDER is the legacy default for both.
PAYMENT_PROVIDER=mock
MPESA_PROVIDER=mock
CARD_PROVIDER=
MOCK_PAYMENT_WEBHOOK_SECRET=change-me

# ─── M-Pesa Express (Safaricom Daraja) — see docs/MPESA.md ─────────────────
# sandbox → https://sandbox.safaricom.co.ke · production → https://api.safaricom.co.ke
DARAJA_ENV=sandbox
# From your Daraja app (daraja.safaricom.co.ke → My Apps). Server-side only.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
# BusinessShortCode: Paybill number, or the Store/Head-Office number for a Till.
DARAJA_SHORTCODE=
# PartyB: leave empty for Paybill (= shortcode); the Till number for Buy Goods.
DARAJA_PARTY_B=
# Lipa Na M-Pesa Online passkey (sandbox: simulator test data; production: emailed after Go Live).
DARAJA_PASSKEY=
# CustomerPayBillOnline (Paybill) | CustomerBuyGoodsOnline (Till)
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public HTTPS URL of the callback route, WITHOUT the token, e.g.
#   https://tickets.example.com/api/payments/stk/callback
DARAJA_CALLBACK_URL=
# Secret path segment appended to the callback URL (openssl rand -hex 24).
DARAJA_CALLBACK_TOKEN=
# Request timeout per Daraja call (ms).
DARAJA_TIMEOUT_MS=15000
# Confirm every callback with an STK status query before acting on it (recommended).
DARAJA_VERIFY_CALLBACKS=true
# Optional comma-separated source-IP allowlist for callbacks (only behind a proxy
# that sets X-Forwarded-For reliably). Empty = token-only.
DARAJA_CALLBACK_ALLOWED_IPS=
# Must be "true" before DARAJA_ENV=production will charge real money.
DARAJA_LIVE_PAYMENTS_ENABLED=false

# ─── Email ───────────────────────────────────────────────────────────────────
# EMAIL_TRANSPORT:
#   dev-capture  writes messages to ./storage/mail (view at /dev/mail). NEVER delivers.
#   resend       Resend API (recommended for production) — see docs/EMAIL.md.
#   smtp         any SMTP server via SMTP_URL (e.g. Mailpit at smtp://localhost:1025).
#   disabled     every send fails visibly.
EMAIL_TRANSPORT=dev-capture
SMTP_URL=
# Legacy sender used by dev-capture/smtp when RESEND_FROM_EMAIL is empty.
EMAIL_FROM="Tikiti <tickets@example.com>"
SUPPORT_EMAIL=support@example.com
# Ticket PDFs larger than this are not attached; the email links to the secure download instead.
EMAIL_MAX_ATTACHMENT_BYTES=10485760

# ─── Resend (server-only — never expose these to the browser) ───────────────
# API key: resend.com → API Keys (a "Sending access" key is enough to send; a
# "Full access" key also lets the admin "Check sender domain" button work).
RESEND_API_KEY=
# Must be on a domain verified in Resend (resend.com → Domains), e.g. tickets@yourdomain.co.ke.
# Until a domain is verified you can test with onboarding@resend.dev, which only
# delivers to the email address that owns your Resend account.
RESEND_FROM_EMAIL=
RESEND_FROM_NAME="Tikiti"
# Where customer replies go (defaults to SUPPORT_EMAIL).
RESEND_REPLY_TO=
# Signing secret (whsec_…) of the webhook endpoint https://<your-site>/api/webhooks/resend
RESEND_WEBHOOK_SECRET=
RESEND_TIMEOUT_MS=20000

# Optional: deliver Clerk's verification / password-reset emails through Resend.
# Signing secret of a Clerk webhook (event: email.created) → https://<your-site>/api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=

# ─── AI Banner Studio (OpenAI Image API) — see docs/AI_BANNERS.md ────────────
# Server-only. Never prefix with NEXT_PUBLIC_. Without these, organizers can still upload images.
OPENAI_API_KEY=
# A current GPT Image model from https://developers.openai.com/api/docs/guides/image-generation
# (e.g. gpt-image-2.5-flare). Must start with "gpt-image-".
OPENAI_IMAGE_MODEL=
# low | medium | high | auto — higher quality costs more per image.
OPENAI_IMAGE_QUALITY=medium
# OPENAI_IMAGE_TIMEOUT_MS=120000

# ─── Storage ─────────────────────────────────────────────────────────────────
# "local" stores uploads in ./storage/uploads (dev only; not durable on most hosts).
# "supabase" stores them in a public Supabase Storage bucket (use this on Vercel).
STORAGE_DRIVER=local
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=          # Supabase → Project Settings → API Keys → secret key. Server only.
# SUPABASE_STORAGE_BUCKET=event-images

# ─── Background jobs ─────────────────────────────────────────────────────────
# Run the outbox worker inside the Next.js server process (handy for dev).
# In production run `npm run worker` as a separate process and set this to false.
JOBS_INLINE_WORKER=true
# Serverless hosts (Vercel): set JOBS_INLINE_WORKER=false and let a scheduler call
# /api/cron/tick every minute with "Authorization: Bearer <CRON_SECRET>" (see docs/PRODUCTION.md).
# CRON_SECRET=                   # e.g. openssl rand -hex 32

# ─── Maps & venue search ─────────────────────────────────────────────────────
# Venue search for organizers is proxied via /api/geocode (server-side only).
# Default: the public Nominatim (OpenStreetMap) instance — free but rate-limited
# (≤1 req/s, no autocomplete, identify yourself). Self-host or use a commercial
# Nominatim-compatible endpoint for production. "disabled" = pins placed manually.
GEOCODER_PROVIDER=nominatim
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_CONTACT_EMAIL=you@example.com
# Map tiles (public, shown in the browser — must not be a secret key).
# Default: tile.openstreetmap.org (light use only; see OSM tile usage policy).
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# ─── Authentication (Clerk) ──────────────────────────────────────────────────
# Written by `clerk init`. Publishable key is public; the secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account
